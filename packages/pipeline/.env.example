# KAGE Pipeline — environment variables
# 本番や CI では export 設定、ローカルでは .env に複写して利用。

# Anthropic API key (LLM 分類 / 推論に必要)。tests/llm の cassette 記録時のみ必要、
# pytest 通常実行や deterministic pipeline には不要。
ANTHROPIC_API_KEY=sk-ant-...

# LLM 並列度。高すぎると rate limit、低すぎると遅い。
KAGE_LLM_MAX_CONCURRENT=5

# 1 bundle 処理あたりの LLM コスト上限 (USD)。これを超えると RuntimeError。
KAGE_LLM_COST_LIMIT_USD=1.00

# LLM ログと IR 出力先の親ディレクトリ。CLI の --log-dir で上書き可能。
# 未指定時: ./.kage-logs/<project-slug>-<UTC-iso>/
KAGE_LOG_DIR=
